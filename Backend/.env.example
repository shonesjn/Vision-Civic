# ── Vision Civic — Backend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your real values.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/Vision_Civic
MONGODB_DATABASE=Vision_Civic

# JWT
JWT_SECRET=your_super_secret_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── WhatsApp Alerts via Twilio ─────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp sender number (use sandbox: +14155238886 for testing)
TWILIO_WHATSAPP_FROM=+14155238886

# Admin WhatsApp number (with country code, no spaces)
# Example for India: +919876543210
ADMIN_WHATSAPP_TO=+91XXXXXXXXXX
